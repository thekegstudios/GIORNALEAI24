# Importare nel pannello Netlify, ambiti Builds e Functions.
# Questo file e un modello: non inserirvi segreti e non caricare .env.local.
# Impostare i valori di produzione nel contesto Production.
SITE_URL=https://NOME-PROGETTO.netlify.app
SITE_INDEXABLE=false
ADMIN_USERNAME=redazione
ADMIN_PASSWORD=
SESSION_SECRET=
CRON_SECRET=

# PostgreSQL server-side. Lasciare vuoto DATABASE_URL se si crea Netlify Database:
# Netlify fornisce automaticamente NETLIFY_DB_URL. Nessun DATABASE_PATH su cloud.
DATABASE_URL=
AWS_LAMBDA_JS_RUNTIME=nodejs24.x
SCHEDULER_MODE=http
# Abilitare soltanto dopo verifica DB, sorgenti e primo ciclo manuale.
NETLIFY_JOBS_ENABLED=false
NETLIFY_JOBS_ALLOW_PREVIEW=false
FUEL_DATA_ENABLED=true
ECONOMIC_DATA_ENABLED=true
SPORTS_ENABLED=false
SPORTS_PAID_PLAN_AUTHORIZED=false
AI_AUTO_PUBLISH=false
ANALYTICS_ENABLED=false
ADS_ENABLED=false
HEALTHCHECK_PROBE_WEB=true
WATCHDOG_INTERVAL_SECONDS=60

# OpenAI e sport restano disattivi senza configurazione esplicita e budget.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
APISPORTS_KEY=
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_WEBHOOK_SECRET=
