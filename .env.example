# Node.js 24+. Copiare in .env.local, oppure eseguire: node scripts/setup-local.mjs
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
DATABASE_PATH=./data/italia-ora.sqlite
# Opzionale: PostgreSQL/Supabase tramite connection string server-side del pooler
DATABASE_URL=
# Per TLS verificato aggiungere ?sslmode=verify-full alla connection string.

# Generare credenziali casuali con setup-local; mai usare questi campi vuoti in pubblico
ADMIN_USERNAME=redazione
ADMIN_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
# Lasciare vuoto salvo proxy controllato che SOVRASCRIVE questo header
TRUSTED_CLIENT_IP_HEADER=

# L'AI resta disattiva senza chiave E prezzi conservativi espliciti.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10
# Testi AI: revisione umana predefinita. Abilitare solo con policy editoriale validata.
AI_AUTO_PUBLISH=false

# Nessun tracker o script pubblicitario è attivo per default
ANALYTICS_ENABLED=false
ADS_ENABLED=false
# Modalità schedulazione: worker persistente (default) oppure scheduler HTTP configurato.
SCHEDULER_MODE=worker

# Importazioni condivise dei dati pubblici. Nessuna chiave o costo API.
FUEL_DATA_ENABLED=true
ECONOMIC_DATA_ENABLED=true
# Sport: configurare prima chiave, diritti e competizioni nel pannello.
SPORTS_ENABLED=false
APISPORTS_KEY=
APISPORTS_DAILY_CAP=100
SPORTS_PAID_PLAN_AUTHORIZED=false
# Limiti antiabuso dell'assistente, oltre ai budget nel database.
CHAT_REQUESTS_PER_WINDOW=15
CHAT_RATE_WINDOW_SECONDS=600
# Supervisore indipendente. Webhook facoltativo, esclusivamente server-side.
WATCHDOG_INTERVAL_SECONDS=60
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_WEBHOOK_SECRET=
HEALTH_ALERT_COOLDOWN_MINUTES=60
HEALTHCHECK_PROBE_WEB=false
HEALTHCHECK_SECRET=
# Predisposizione notifiche push: non attive, richiede un servizio completo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
